{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "shared/renewableEnergy/layout/**/*.ts",
    "src/features/renewable-energy/layout/**/*.tsx",
    "scripts/test-layout-*.ts",
    "shared/renewableEnergy/components/**/*.ts",
    "shared/renewableEnergy/draflioScene*.ts"
  ]
}
